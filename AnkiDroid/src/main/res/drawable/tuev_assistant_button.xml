<?xml version="1.0" encoding="utf-8"?>
<!-- Win98-Knopf: grau mit 3D-Kante (hell oben links, dunkel unten rechts) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#FF000000"/></shape></item>
            <item android:left="1dp" android:top="1dp"><shape><solid android:color="#FFFFFFFF"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#FF808080"/></shape></item>
            <item android:left="2dp" android:top="2dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#FFC0C0C0"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#FF000000"/></shape></item>
            <item android:right="1dp" android:bottom="1dp"><shape><solid android:color="#FFFFFFFF"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#FF808080"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#FFC0C0C0"/></shape></item>
        </layer-list>
    </item>
</selector>
