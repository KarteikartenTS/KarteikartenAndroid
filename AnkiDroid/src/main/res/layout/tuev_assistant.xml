<?xml version="1.0" encoding="utf-8"?>
<!-- TÜV SÜD Akademie: Lern-Assistent (Overlay über der Deckliste, unten links) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tuev_assistant_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/tuev_assistant_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tuev_assistant_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:background="@drawable/tuev_assistant_bubble"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tuev_assistant_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF000000"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Hallo!" />

            <TextView
                android:id="@+id/tuev_assistant_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxWidth="276dp"
                android:textColor="#FF000000"
                android:textSize="14sp"
                tools:text="Ich bin Karla und zeige dir die App." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tuev_assistant_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="#FF555555"
                    android:textSize="12sp"
                    tools:text="1/9" />

                <TextView
                    android:id="@+id/tuev_assistant_back"
                    style="@style/TuevAssistantButton"
                    android:text="@string/tuev_assistant_back" />

                <TextView
                    android:id="@+id/tuev_assistant_next"
                    style="@style/TuevAssistantButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/tuev_assistant_next" />
            </LinearLayout>

            <TextView
                android:id="@+id/tuev_assistant_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:text="@string/tuev_assistant_close"
                android:textColor="#FF0000EE"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tuev_assistant_tail"
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="-1dp"
            android:elevation="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/tuev_assistant_bubble_tail" />

        <ImageView
            android:id="@+id/tuev_assistant_character"
            android:layout_width="84dp"
            android:layout_height="98dp"
            android:contentDescription="@string/tuev_assistant_name"
            android:src="@drawable/tuev_assistant_karla" />
    </LinearLayout>
</FrameLayout>
